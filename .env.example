# Copy this file to .env.
# ANTHROPIC_API_KEY powers the "Ask a question about this data" panel (Claude API).
# Get a key from console.anthropic.com — the dashboard works fine without one,
# the Q&A panel just shows a message asking for it.
ANTHROPIC_API_KEY=

# EMISSIONS_API_KEY / EMISSIONS_API_BASE_URL are unused placeholders for a future
# external emissions-data API. The dashboard currently reads only the bundled CSV.
EMISSIONS_API_KEY=
EMISSIONS_API_BASE_URL=
